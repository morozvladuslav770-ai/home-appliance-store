# Скопіюйте цей файл у backend/.env і заповніть (файл .env не потрапляє в git).
# Без SMTP_USER листи в development пишуться у файли backend/tmp/mails.

# Gmail: увімкніть двоетапну перевірку й створіть «Пароль застосунку»
# https://myaccount.google.com/apppasswords
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop

# Необов'язково (значення за замовчуванням показано)
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# MAIL_FROM=ТехноДім <your.address@gmail.com>
# FRONTEND_URL=http://localhost:5173/home-appliance-store

# ШІ-помічник з підбору техніки (Google Gemini).
# Безкоштовний ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Модель можна змінити, якщо Google змінить назви (список у Google AI Studio)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Запасний варіант, якщо Google не дає безкоштовний доступ до Gemini для вашого проєкту:
# будь-який OpenAI-сумісний сервіс. Приклад для Groq (ключ: https://console.groq.com/keys).
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
