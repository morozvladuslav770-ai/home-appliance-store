# Скопіюйте цей файл у backend/.env і заповніть (файл .env не потрапляє в git).
# Без SMTP_USER листи в development пишуться у файли backend/tmp/mails.

# Gmail: увімкніть двоетапну перевірку й створіть «Пароль застосунку»
# https://myaccount.google.com/apppasswords
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop

# Необов'язково (значення за замовчуванням показано)
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# MAIL_FROM=ТехноДім <your.address@gmail.com>
# FRONTEND_URL=http://localhost:5173/home-appliance-store
